# Keep the reproducible corpora, current reports, caches, and final render
# evidence. Ignore superseded QA output and ad-hoc reruns by default.
!/qa-reports/
/qa-reports/*
!/qa-reports/benchmark-smoke-cases.json
!/qa-reports/benchmark-smoke-report.md
!/qa-reports/benchmark-smoke-results.json
